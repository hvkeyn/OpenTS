    PUSHBUTTON      "Главное меню",IDC_EXCEPT_MAINMENU,217,200,60,14
    CTEXT           "Tiberian Sun столкнулась с проблемой.\nПодробности в файле DEBUG.TXT.",
                    -1,7,7,280,26,NOT WS_GROUP
