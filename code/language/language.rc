    EDITTEXT        IDC_EXCEPT_DETAILS,17,53,261,140,ES_MULTILINE | 
                    ES_NOHIDESEL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL | 
                    WS_HSCROLL
    LTEXT           "Подробности:",IDC_EXCEPT_DETAILS_LABEL,19,41,45,8
END

